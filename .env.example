# @inverz/delivery-status: ตัวแปรสำหรับ createTrackerFromEnv()
# ใส่เฉพาะ provider ที่ใช้ ถ้าใส่ตัวที่ไม่ได้เขียนว่า (optional) ครบ provider นั้นจะเปิดเอง
# ลำดับในไฟล์คือลำดับที่ถูกถาม ตัวถัดไปถูกถามเฉพาะเมื่อตัวก่อนหน้าไม่มีข้อมูลพัสดุ
# ใช้ฝั่ง server เท่านั้น ห้ามใส่ใน VITE_ / NEXT_PUBLIC_

# ======================================================================
# API ของขนส่งเอง: ต้องมีบัญชีร้านค้ากับขนส่ง ดูได้เฉพาะพัสดุที่ร้านส่งเอง
# ======================================================================

# Flash Express
# merchant number (mchId), from Flash staff
FLASH_MCH_ID=
# API key for signing
FLASH_API_KEY=
# (optional) true for the training system
FLASH_SANDBOX=

# Ninja Van
# Ninja Dashboard → Settings → IT Settings
NINJAVAN_CLIENT_ID=
# the Client Key shown with it
NINJAVAN_CLIENT_SECRET=
# (optional) th (default)
NINJAVAN_COUNTRY=
# (optional) true for sandbox
NINJAVAN_SANDBOX=

# J&T Express
# apiAccount of a certified J&T open-platform account
JT_API_ACCOUNT=
# privateKey issued with it
JT_PRIVATE_KEY=
# (optional) API root if J&T Thailand gives you a different one
JT_BASE_URL=
# (optional) true for the demo system
JT_SANDBOX=

# DHL eCommerce Asia
# clientId from DHL eCommerce Asia
DHL_ECOMMERCE_CLIENT_ID=
# API password
DHL_ECOMMERCE_PASSWORD=
# (optional) soldTo account id (more detail in answers)
DHL_ECOMMERCE_SOLDTO_ACCOUNT=
# (optional) pickup account id
DHL_ECOMMERCE_PICKUP_ACCOUNT=
# (optional) true for the pre-production system
DHL_ECOMMERCE_SANDBOX=

# ======================================================================
# Marketplace: ค้นจากเลขคำสั่งซื้อ ต้องส่ง hooks findOrder และ getAccessToken ในโค้ดด้วย
# ======================================================================

# Shopee Open Platform  (hooks: findOrder, getAccessToken)
# partner_id of your app
SHOPEE_PARTNER_ID=
# partner_key
SHOPEE_PARTNER_KEY=
# (optional) shop_id, unless findOrder returns it
SHOPEE_SHOP_ID=
# (optional) true for the test host
SHOPEE_SANDBOX=

# Lazada Open Platform  (hooks: findOrder, getAccessToken)
# app_key
LAZADA_APP_KEY=
# app_secret
LAZADA_APP_SECRET=

# TikTok Shop  (hooks: findOrder, getAccessToken)
# app_key
TIKTOK_SHOP_APP_KEY=
# app_secret
TIKTOK_SHOP_APP_SECRET=
# (optional) shop_cipher (cross-border shops)
TIKTOK_SHOP_CIPHER=

# ======================================================================
# ไปรษณีย์ไทย: ฟรี ใช้ได้กับทุกเลข
# ======================================================================

# Thailand Post (ไปรษณีย์ไทย)
# free token from https://track.thailandpost.co.th/developerGuide
THAILAND_POST_TOKEN=
# (optional) TH (default), EN or CN
THAILAND_POST_LANGUAGE=

# ======================================================================
# Aggregator: เสียเงิน ใช้ได้ทุกขนส่ง ถูกถามเป็นลำดับสุดท้าย
# ======================================================================

# eTrackings (Thai: Kerry, Flash, J&T, SPX, BEST, Nim, DHL eCommerce)
# API Key from https://apps.etrackings.com → Settings → API Keys
ETRACKINGS_API_KEY=
# Key Secret shown with it
ETRACKINGS_KEY_SECRET=
# (optional) th (default) or en
ETRACKINGS_LANGUAGE=

# TrackingMore
# https://www.trackingmore.com
TRACKINGMORE_API_KEY=

# 17TRACK
# 17token from https://api.17track.net
TRACK17_API_KEY=

# Track123
# https://www.track123.com
TRACK123_API_SECRET=

# AfterShip
# https://www.aftership.com
AFTERSHIP_API_KEY=

# Ship24
# https://www.ship24.com
SHIP24_API_KEY=
